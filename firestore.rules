rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'website', 'phone', 'socials', 'service', 'message', 'createdAt']);
      allow read, delete: if request.auth != null;
      allow update: if false;
    }
    match /audits/{id} {
      allow create: if request.resource.data.keys().hasAll(['fullName', 'businessName', 'email', 'website', 'challenge', 'auditType', 'createdAt']);
      allow read, delete: if request.auth != null;
    }
    match /portfolio/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

