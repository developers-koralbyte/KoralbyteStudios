rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll(['name', 'email', 'service', 'message', 'createdAt'])
        && data.keys().size() == 5
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.service is string && data.service.size() > 0 && data.service.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 2000
        && data.createdAt == request.time;
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && isValidInquiry(incoming());
      allow read, update, delete: if false;
    }

    function isValidAuditRequest(data) {
      return data.keys().hasAll(['fullName', 'businessName', 'email', 'website', 'challenge', 'auditType', 'createdAt'])
        && data.keys().size() == 7
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.businessName is string && data.businessName.size() > 0 && data.businessName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 150
        && data.website is string && data.website.size() >= 0 && data.website.size() <= 200
        && data.challenge is string && data.challenge.size() > 0 && data.challenge.size() <= 2000
        && data.auditType is string && data.auditType in ['free', 'brand']
        && data.createdAt == request.time;
    }

    match /audits/{auditId} {
      allow create: if isValidId(auditId) && isValidAuditRequest(incoming());
      allow read, update, delete: if false;
    }
  }
}
